#!/bin/bash
# bunny-toggle-ssh
#
# Start or stop sshd for this boot only.
#
# `start`/`stop`, never `enable`: an enabled sshd is a listening daemon from
# every boot onward, which is both idle RAM and an open port you did not ask
# for each morning. Turning SSH on is a decision for a session, not one made
# once and inherited forever. A reboot always returns it to off.
#
# Port 22 is already open in ufw (install/50-firewall.sh), so starting sshd is
# all it takes to be reachable.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=local/bin/lib/helpers.sh
source "$SCRIPT_DIR/lib/helpers.sh"

require_terminal "$0" "$@"

if systemctl is-active --quiet sshd; then
  sudo systemctl stop sshd
  bunny-notify "SSH" "sshd stopped"
else
  sudo systemctl start sshd
  bunny-notify "SSH" "sshd is listening on port 22, until the next reboot"
fi
