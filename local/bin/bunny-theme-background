#!/bin/bash
#
# bunny-theme-background — Set the desktop wallpaper
#
# Usage:
#   bunny-theme-background <url-or-path>   set a specific image
#   bunny-theme-background --next          cycle forward through the collection
#   bunny-theme-background --previous      cycle back
#
# Cycling rather than a picker menu: choosing a wallpaper from a list means
# looking at names, not pictures, so the list never helps. Pressing a key until
# one looks right is the same decision with none of the reading.
#
# Copies or downloads to ~/background.jpg, then restarts swaybg. Hyprlock picks
# the new image up on the next lock.

set -euo pipefail

TARGET="$HOME/background.jpg"
WALLPAPER_DIR="${BUNNY_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/bunny/wallpaper"

usage() {
  echo "Usage: bunny-theme-background <url-or-path> | --next | --previous"
  exit 1
}

apply() {
  local src=$1

  if [[ $src =~ ^https?:// ]]; then
    echo "Downloading $src..."
    curl -fSL -o "$TARGET" "$src"
  else
    [[ -f $src ]] || { echo "Error: File not found: $src" >&2; exit 1; }
    cp -- "$src" "$TARGET"
    echo "Copied $src → $TARGET"
  fi

  mkdir -p -- "${STATE_FILE%/*}"
  printf '%s\n' "$src" > "$STATE_FILE"

  if systemctl --user is-active swaybg.service &>/dev/null; then
    systemctl --user restart swaybg.service
    echo "swaybg restarted."
  else
    echo "Note: swaybg.service is not running."
  fi
}

# Step through the collection, wrapping at both ends. The last-set path is
# remembered rather than compared by content: ~/background.jpg is a copy, so
# there is nothing to match it back to its source by.
cycle() {
  local direction=$1
  local -a wallpapers=()
  mapfile -t wallpapers < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort)

  if ((${#wallpapers[@]} == 0)); then
    bunny-notify -u critical "Wallpaper" "No images in ${WALLPAPER_DIR/#$HOME/\~}"
    exit 1
  fi

  local current="" index=-1 i
  [[ -f $STATE_FILE ]] && current=$(<"$STATE_FILE")
  for i in "${!wallpapers[@]}"; do
    [[ ${wallpapers[$i]} == "$current" ]] && { index=$i; break; }
  done

  local count=${#wallpapers[@]} next
  if ((index < 0)); then
    # Nothing set yet, or the remembered file is gone: start at the beginning.
    next=0
  elif [[ $direction == next ]]; then
    next=$(((index + 1) % count))
  else
    next=$(((index - 1 + count) % count))
  fi

  apply "${wallpapers[$next]}"
  bunny-notify "Wallpaper" "$(basename -- "${wallpapers[$next]}")"
}

case "${1:-}" in
  --next)     cycle next ;;
  --previous) cycle previous ;;
  "" | -h | --help) usage ;;
  *)          apply "$1"; echo "Done. Wallpaper updates!" ;;
esac
