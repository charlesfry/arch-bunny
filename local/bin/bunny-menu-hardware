#!/bin/bash
# bunny-menu-hardware [entry]
#
# Restart one piece of hardware instead of rebooting the machine for it.
# Almost every "I'll just reboot" is really one of these five.
#
# Takes the chosen entry as an argument so it can re-exec itself into a
# terminal for the ones needing sudo without losing the choice.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=local/bin/lib/helpers.sh
source "$SCRIPT_DIR/lib/helpers.sh"

# Resolve the touchpad's driver from sysfs rather than assuming a module name:
# it is hid_multitouch on this Framework, but the lookup costs three lines and
# does not have to be revisited on different hardware.
touchpad_module() {
  local name_file driver
  for name_file in /sys/class/input/*/name; do
    [[ $(<"$name_file") == *[Tt]ouchpad* ]] || continue
    driver=$(readlink -f "${name_file%/name}/device/driver" 2>/dev/null) || continue
    [[ -n $driver ]] || continue
    basename -- "$driver" | tr - _
    return 0
  done
  return 1
}

choice="${1:-}"
if [[ -z $choice ]]; then
  choice=$(printf '%s\n' \
    "Wi-Fi" \
    "Bluetooth" \
    "Audio" \
    "Networking" \
    "Touchpad" \
    | bunny-launch-menu "Restart:") || exit 0
fi
[[ -n $choice ]] || exit 0

# Audio is entirely user units, so it is the one entry that needs no terminal.
if [[ $choice != Audio ]]; then
  require_terminal "$0" "$choice"
fi

case $choice in
  Wi-Fi)      sudo systemctl restart iwd ;;
  Bluetooth)  sudo systemctl restart bluetooth ;;
  Audio)      systemctl --user restart wireplumber pipewire-pulse pipewire ;;
  Networking) sudo systemctl restart systemd-networkd systemd-resolved ;;
  Touchpad)
    module=$(touchpad_module) || {
      bunny-notify -u critical "Restart" "No touchpad driver found"
      exit 1
    }
    sudo modprobe -r "$module"
    sudo modprobe "$module"
    ;;
  *) exit 0 ;;
esac

bunny-notify "Restarted" "$choice"
