#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/helpers.sh"

# Ensure swayidle is back on so the screen turns off
SERVICE="swayidle.service"
systemctl --user start "$SERVICE"
signal_waybar "10"

# Lock
LOCK_CMD="hyprlock"
exec $LOCK_CMD
