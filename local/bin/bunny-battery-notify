#!/bin/bash
set -euo pipefail

BAT=/sys/class/power_supply/BAT1
STATE_FILE=/run/bunny-battery-notify.state

[[ -r "$BAT/capacity" && -r "$BAT/status" ]] || exit 0

status=$(<"$BAT/status")
capacity=$(<"$BAT/capacity")
last=$(cat "$STATE_FILE" 2>/dev/null || echo none)

if [[ "$status" != "Discharging" ]]; then
  level=none
elif (( capacity <= 5 )); then
  level=critical
elif (( capacity <= 20 )); then
  level=low
else
  level=none
fi

# exit early if no change in level
[[ "$level" == "$last" ]] && exit 0
echo "$level" > "$STATE_FILE"

# Resolve the active graphical session's user
active_session=$(loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null)
target_uid=$(loginctl show-session "$active_session" -p User --value 2>/dev/null)
[[ -n "$target_uid" ]] || exit 0

as_user() {
  sudo -u "#$target_uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$target_uid/bus" "$@"
}

case "$level" in
  critical)
    as_user notify-send -u critical -a battery "BATTERY CRITICAL" "${capacity}% REMAINING"
    as_user brightnessctl -s set 10% >/dev/null
    ;;
  low)
    as_user notify-send -u normal -a battery "Battery low" "${capacity}% remaining"
    ;;
  none)
    [[ "$last" == "critical" ]] && as_user brightnessctl -r >/dev/null
    ;;
esac
