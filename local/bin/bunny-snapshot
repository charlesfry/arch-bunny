#!/bin/bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  bunny-snapshot create [description]      Snapshot every configured snapper config
  bunny-snapshot restore                   Restore the booted snapshot (limine-snapper-restore)
  bunny-snapshot delete <config> <number>  Delete one snapshot

Run bunny-snapshot-list for config names and snapshot numbers.
EOF
  exit 1
}

snapper_configs() {
  sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}'
}

case "${1:-}" in
create)
  description=${2:-manual}

  printf '\e[32mCreate system snapshot\e[0m\n'
  mapfile -t configs < <(snapper_configs)
  for config in "${configs[@]}"; do
    sudo snapper -c "$config" create -c number -d "$description"
  done
  echo
  ;;
restore)
  read -r -p "Restore the currently booted snapshot? [y/N] " answer
  if [[ ! $answer =~ ^[Yy]$ ]]; then
    echo "Restore cancelled."
    exit 0
  fi
  sudo limine-snapper-restore
  ;;
delete)
  config=${2:-}
  number=${3:-}

  if [[ -z $config || ! $number =~ ^[1-9][0-9]*$ ]]; then
    echo "A config name and snapshot number from 'bunny-snapshot-list' are required." >&2
    usage
  fi
  if ! snapper_configs | grep -qx "$config"; then
    echo "Unknown snapper config: $config" >&2
    exit 1
  fi

  printf '\e[32mDelete %s snapshot %s\e[0m\n' "$config" "$number"
  sudo snapper -c "$config" delete "$number"
  echo
  ;;
*)
  usage
  ;;
esac
