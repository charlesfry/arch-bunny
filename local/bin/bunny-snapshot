#!/bin/bash
set -euo pipefail

COMMAND="${1:-}"

if [[ -z $COMMAND ]]; then
  echo "Usage: bunny-snapshot <create|restore|delete>" >&2
  exit 1
fi

case "$COMMAND" in
create)
  DESC="$(date +'%m-%d-%Y')"

  echo -e "\e[32mCreate system snapshot\e[0m"

  # Get existing snapper config names from CSV output
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')

  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number # -d "$DESC"
  done
  echo
  ;;
restore)
  sudo limine-snapper-restore
  ;;
delete)
  echo -e "\e[32mDelete latest snapshot\e[0m"

  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')

  for config in "${CONFIGS[@]}"; do
    latest="$(sudo snapper -c "$config" --csvout list | awk -F, 'NR>1 {id=$1} END {print id}')"
    if [[ -n "$latest" && "$latest" != "0" ]]; then
      sudo snapper -c "$config" delete "$latest"
    fi
  done
  echo
  ;;
esac
