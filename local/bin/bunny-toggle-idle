#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/helpers.sh"

SERVICE="swayidle.service"

if systemctl --user is-active --quiet "$SERVICE"; then
  systemctl --user stop "$SERVICE"
else
  systemctl --user start "$SERVICE"
fi

signal_waybar "10"
