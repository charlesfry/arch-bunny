#!/bin/bash
# Notify about upcoming Google Calendar events via bunny-notify.
#
# Reads private "secret address in iCal format" URLs, one per line, from
# ~/.config/bunny/calendar-ics-url (Calendar Settings > pick calendar >
# Integrate calendar).

# ponytail: RRULE support covers FREQ=DAILY, FREQ=WEEKLY;BYDAY=..., FREQ=MONTHLY
# with either BYMONTHDAY=... or BYDAY=... including positional ("2TU", "-1FR"),
# and FREQ=YEARLY on DTSTART's month and day. INTERVAL/UNTIL/WKST/EXDATE honored;
# COUNT is ignored and treated as unbounded. BYSETPOS/BYWEEKNO/BYYEARDAY are not
# expanded. Add those if a real calendar ever needs them.

set -Eeuo pipefail
trap 'e=$?; echo "$0: line $LINENO exited $e" >&2' ERR

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/bunny
url_file="$config_dir/calendar-ics-url"
[[ -r "$url_file" ]] || exit 0

# Skip blanks and duplicate URLs (a repeated line means fetching+parsing the
# same calendar twice per tick).
declare -A seen_url
calendar_urls=()
while read -r line || [[ -n "$line" ]]; do
	line="${line%$'\r'}"
	[[ -n "${line//[[:space:]]/}" ]] || continue
	[[ -n "${seen_url["$line"]+x}" ]] && continue
	seen_url["$line"]=1
	calendar_urls+=("$line")
done <"$url_file"
((${#calendar_urls[@]})) || exit 0

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/bunny-calendar-notify
state_file="$state_dir/notified"
mkdir -p "$state_dir"
: >>"$state_file"

# Never run two copies at once: the state file is read-modify-written below, so
# a manual run racing the timer could drop a just-recorded notification.
exec 9>"$state_dir/.lock"
flock -n 9 || exit 0

calendar_icon=/usr/share/icons/AdwaitaLegacy/48x48/mimetypes/x-office-calendar.png
default_lead_secs=600 # 10 min, used when an event has no VALARM
grace_secs=3600        # don't notify for occurrences that started more than this long ago (handles suspend gaps)

printf -v now '%(%s)T' -1

# Drop state entries a day after the occurrence they cover, so the file doesn't
# grow forever. Keyed on the occurrence start (field 2 from the end of the key,
# so a "|" inside a UID can't shift it) rather than on when the notification was
# sent: a week-ahead reminder must stay deduped until its event has passed.
awk -F'\t' -v cutoff=$((now - 86400)) '{n = split($1, k, "|")} n > 2 && k[n-1] >= cutoff' "$state_file" >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"

declare -A notified_keys
while IFS=$'\t' read -r notified_key _; do
	[[ -n "$notified_key" ]] && notified_keys["$notified_key"]=1
done <"$state_file"

tz_date() {
	local tz="$1"
	shift
	if [[ -n "$tz" ]]; then TZ="$tz" date "$@"; else date "$@"; fi
}

# -> $unesc
unescape() {
	unesc="${1//\\n/ }"
	unesc="${unesc//\\N/ }"
	unesc="${unesc//\\,/,}"
	unesc="${unesc//\\;/;}"
	unesc="${unesc//\\\\/\\}"
}

# YYYYMMDDTHHMMSS (no trailing Z — strip it and pass tz="UTC" first) -> epoch.
ics_time_to_epoch() {
	local raw="$1" tz="$2"
	tz_date "$tz" -d "${raw:0:4}-${raw:4:2}-${raw:6:2} ${raw:9:2}:${raw:11:2}:${raw:13:2}" +%s
}

# YYYYMMDD -> epoch at local midnight, honoring tz.
ics_date_to_epoch() {
	local raw="$1" tz="$2"
	tz_date "$tz" -d "${raw:0:4}-${raw:4:2}-${raw:6:2}" +%s
}

# Splits a DTSTART/RECURRENCE-ID/EXDATE field into $sdt_tz / $sdt_value /
# $sdt_all_day, where tz is a real TZ name, "UTC" (a trailing Z on the value),
# or "" (floating/local). The value never keeps its trailing Z — tz has it.
# Assigns globals rather than printing: this runs once per VEVENT and a
# command substitution here costs a fork apiece.
split_dt() {
	local params="${1%%:*}"
	sdt_value="${1#*:}"
	sdt_tz=""
	sdt_all_day=0
	if [[ "$params" == *"VALUE=DATE"* && "$params" != *"VALUE=DATE-TIME"* ]]; then
		sdt_all_day=1
		return
	fi
	if [[ "$sdt_value" == *Z ]]; then
		sdt_tz="UTC"
		sdt_value="${sdt_value%Z}"
	elif [[ "$params" =~ TZID=([^;:]+) ]]; then
		sdt_tz="${BASH_REMATCH[1]}"
	fi
}

# Any DTSTART-shaped field -> $sdt_epoch. Fails on unparseable values.
field_to_epoch() {
	split_dt "$1"
	if ((sdt_all_day)); then
		sdt_epoch=$(ics_date_to_epoch "$sdt_value" "$sdt_tz")
	else
		sdt_epoch=$(ics_time_to_epoch "$sdt_value" "$sdt_tz")
	fi
}

# "-PT10M", "-P1W" etc -> signed seconds in $trig_secs.
# Fails (unsupported) for absolute date-time triggers.
trigger_seconds() {
	local t="$1" sign=1
	[[ "$t" == -* ]] && {
		sign=-1
		t="${t#-}"
	}
	[[ "$t" == +* ]] && t="${t#+}"
	[[ "$t" == P* ]] || return 1
	t="${t#P}"
	local datepart="${t%%T*}" timepart="" secs=0
	[[ "$t" == *T* ]] && timepart="${t#*T}"
	[[ "$datepart" =~ ([0-9]+)W ]] && secs=$((secs + ${BASH_REMATCH[1]} * 604800))
	[[ "$datepart" =~ ([0-9]+)D ]] && secs=$((secs + ${BASH_REMATCH[1]} * 86400))
	[[ "$timepart" =~ ([0-9]+)H ]] && secs=$((secs + ${BASH_REMATCH[1]} * 3600))
	[[ "$timepart" =~ ([0-9]+)M ]] && secs=$((secs + ${BASH_REMATCH[1]} * 60))
	[[ "$timepart" =~ ([0-9]+)S ]] && secs=$((secs + ${BASH_REMATCH[1]}))
	trig_secs=$((sign * secs))
}

# Comma-joined TRIGGER lines -> $leads (seconds before start, one per VALARM).
# Google emits one VALARM per reminder the user configured, shortest lead first,
# so honoring only the first would drop every "1 day before" reminder.
parse_leads() {
	local raw="$1" t
	leads=()
	while [[ -n "$raw" ]]; do
		t="${raw%%,*}"
		[[ "$raw" == *,* ]] && raw="${raw#*,}" || raw=""
		trigger_seconds "${t#*:}" && leads+=("$((-trig_secs))")
	done
	((${#leads[@]})) || leads=("$default_lead_secs")
}

# Fires one notification per due lead in $leads.
maybe_notify() {
	local uid="$1" start_epoch="$2" summary="$3" location="$4"

	((start_epoch >= now - grace_secs)) || return 0

	local lead alarm_epoch key when body title
	for lead in "${leads[@]}"; do
		alarm_epoch=$((start_epoch - lead))
		((alarm_epoch <= now)) || continue

		key="$uid|$start_epoch|$lead"
		[[ -n "${notified_keys["$key"]+x}" ]] && continue

		printf -v when '%(%-I:%M %p)T' "$start_epoch"
		body="$when"
		if [[ -n "$location" ]]; then
			unescape "$location"
			body="$body — $unesc"
		fi
		unescape "$summary"
		title="$unesc"

		# Record only on success so a transient notify failure retries next tick.
		if bunny-notify -i "$calendar_icon" -a "Google Calendar" "$title" "$body"; then
			printf '%s\t%s\n' "$key" "$now" >>"$state_file"
			notified_keys["$key"]=1
		fi
	done
	return 0
}

days_in_month() { # year month -> $dim
	local -a mdays=(31 28 31 30 31 30 31 31 30 31 30 31)
	dim=${mdays[$2 - 1]}
	(($2 == 2 && ($1 % 4 == 0 && $1 % 100 != 0 || $1 % 400 == 0))) && dim=29
	return 0
}

weekday_index() { # MO..SU -> $wdi (Monday = 0)
	local head="${WEEKDAYS%%$1*}"
	wdi=$((${#head} / 2))
}
WEEKDAYS=MOTUWETHFRSASU

process_calendar() {
	local ics_url="$1"
	local ics
	ics=$(curl -fsS --max-time 10 "$ics_url") || return 0
	[[ -n "$ics" ]] || return 0

	local -A overridden # "UID|occurrence_epoch" -> 1, from RECURRENCE-ID overrides
	local -a base_events single_events
	local uid dtstart recurid rrule exdate trigger summary location status
	local start_epoch rec

	while IFS=$'\x1f' read -r uid dtstart recurid rrule exdate trigger summary location status; do
		[[ -n "$uid" && -n "$dtstart" ]] || continue

		# A moved/modified instance suppresses the base occurrence it replaces.
		# Keyed by the original occurrence's exact start epoch, so a UTC-form
		# RECURRENCE-ID on a TZID event still lines up.
		if [[ -n "$recurid" ]]; then
			field_to_epoch "$recurid" || continue
			overridden["$uid|$sdt_epoch"]=1
		fi

		# A cancelled instance still suppresses the base occurrence above, but
		# must not notify on its own.
		[[ "$status" == "CANCELLED" ]] && continue

		split_dt "$dtstart"
		((sdt_all_day)) && continue

		if [[ -n "$rrule" ]]; then
			base_events+=("$uid"$'\x1f'"$sdt_tz"$'\x1f'"$sdt_value"$'\x1f'"$rrule"$'\x1f'"$exdate"$'\x1f'"$trigger"$'\x1f'"$summary"$'\x1f'"$location")
		else
			start_epoch=$(ics_time_to_epoch "$sdt_value" "$sdt_tz") || continue
			single_events+=("$uid"$'\x1f'"$start_epoch"$'\x1f'"$trigger"$'\x1f'"$summary"$'\x1f'"$location")
		fi
	done < <(
		awk -v SEP=$'\x1f' -v ESEP=$'\x1e' '
      function reset() { uid=""; dtstart=""; summary=""; rrule=""; exdate=""; recurid=""; trigger=""; location=""; status=""; in_valarm=0 }
      function classify(line) {
        if (line ~ /^BEGIN:VEVENT$/) { reset(); in_event=1; return }
        if (line ~ /^BEGIN:VALARM$/) { in_valarm=1; return }
        if (line ~ /^END:VALARM$/) { in_valarm=0; return }
        if (line ~ /^END:VEVENT$/) {
          if (uid != "" && dtstart != "") {
            gsub(SEP, " ", summary); gsub(SEP, " ", location)
            print uid SEP dtstart SEP recurid SEP rrule SEP exdate SEP trigger SEP summary SEP location SEP status
          }
          in_event=0; return
        }
        if (!in_event) return
        if (line ~ /^UID:/) { uid = substr(line, 5); return }
        if (line ~ /^DTSTART/) { dtstart = line; return }
        if (line ~ /^RECURRENCE-ID/) { recurid = line; return }
        if (line ~ /^RRULE:/) { rrule = substr(line, 7); return }
        if (line ~ /^EXDATE/) { exdate = (exdate == "" ? line : exdate ESEP line); return }
        if (in_valarm) { if (line ~ /^TRIGGER/) trigger = (trigger == "" ? line : trigger "," line); return }
        if (line ~ /^STATUS:/) { status = substr(line, 8); return }
        if (line ~ /^SUMMARY[;:]/) { summary = line; sub(/^SUMMARY[^:]*:/, "", summary); return }
        if (line ~ /^LOCATION[;:]/) { location = line; sub(/^LOCATION[^:]*:/, "", location); return }
      }
      BEGIN { reset() }
      {
        sub(/\r$/, "")
        if ($0 ~ /^[ \t]/) { sub(/^[ \t]/, ""); buf = buf $0 }
        else { if (buf != "") classify(buf); buf = $0 }
      }
      END { if (buf != "") classify(buf) }
    ' <<<"$ics"
	)

	for rec in "${single_events[@]}"; do
		IFS=$'\x1f' read -r uid start_epoch trigger summary location <<<"$rec"
		parse_leads "$trigger"
		maybe_notify "$uid" "$start_epoch" "$summary" "$location"
	done

	local tz value orig_hms orig_day_epoch orig_ym orig_wdi freq interval until_epoch u
	local byday wkst wkst_wdi wdi dim lead max_lead max_off exline exv
	local today_mid offset_days cand_day_epoch cand_date cand_dom cand_ym
	local days_diff weekday weeks_diff matches md target cand_epoch
	local byday_days part nth has_bymonthday byday_ok bmd_ok
	local -a exlines exvals bymonthdays byday_parts
	local -A ex_epochs

	for rec in "${base_events[@]}"; do
		IFS=$'\x1f' read -r uid tz value rrule exdate trigger summary location <<<"$rec"

		freq=""
		[[ "$rrule" =~ FREQ=([A-Z]+) ]] && freq="${BASH_REMATCH[1]}"
		[[ "$freq" == "DAILY" || "$freq" == "WEEKLY" || "$freq" == "MONTHLY" || "$freq" == "YEARLY" ]] || continue

		orig_hms="${value:9:6}"
		orig_day_epoch=$(ics_date_to_epoch "${value:0:8}" "$tz") || continue
		orig_ym=$((10#${value:0:4} * 12 + 10#${value:4:2}))

		interval=1
		[[ "$rrule" =~ INTERVAL=([0-9]+) ]] && interval="${BASH_REMATCH[1]}"
		((interval > 0)) || interval=1 # malformed INTERVAL=0 would divide by zero below
		until_epoch=""
		if [[ "$rrule" =~ UNTIL=([0-9TZ]+) ]]; then
			u="${BASH_REMATCH[1]}"
			if [[ "$u" == *T* ]]; then
				field_to_epoch "UNTIL:$u" || continue
				until_epoch=$sdt_epoch
			else
				# A date-only UNTIL is inclusive through the end of that day.
				until_epoch=$(ics_date_to_epoch "$u" "$tz") || continue
				until_epoch=$((until_epoch + 86399))
			fi
		fi
		byday="" byday_days=""
		if [[ "$rrule" =~ BYDAY=([-+0-9A-Z,]+) ]]; then
			byday="${BASH_REMATCH[1]}"
			# The weekday filter below matches bare two-letter codes, so keep a
			# stripped copy: "2TU,-1FR" restricts to TU and FR like any other rule,
			# and the positions are applied per-candidate in the MONTHLY branch.
			IFS=',' read -ra byday_parts <<<"$byday"
			for part in "${byday_parts[@]}"; do
				byday_days+="${byday_days:+,}${part: -2}"
			done
		fi
		# BYSETPOS picks the Nth member of each period's expanded set (RFC 5545
		# 3.3.10). Expanding the set without applying the selection fires on every
		# member, so skip these rather than notify daily.
		[[ "$rrule" == *BYSETPOS=* ]] && continue
		has_bymonthday=0
		[[ "$rrule" == *BYMONTHDAY=* ]] && has_bymonthday=1
		wkst=MO
		[[ "$rrule" =~ WKST=([A-Z][A-Z]) ]] && wkst="${BASH_REMATCH[1]}"

		bymonthdays=("${value:6:2}") # MONTHLY defaults to DTSTART's day of month
		[[ "$rrule" =~ BYMONTHDAY=([-0-9,]+) ]] && IFS=',' read -ra bymonthdays <<<"${BASH_REMATCH[1]}"

		orig_wdi=0
		if [[ "$freq" == "WEEKLY" ]]; then
			weekday=$(tz_date "$tz" -d "@$orig_day_epoch" +%a) || continue
			weekday=${weekday^^}
			weekday=${weekday:0:2}
			# RFC default when BYDAY is absent: DTSTART's own weekday.
			[[ -n "$byday_days" ]] || byday_days="$weekday"
			weekday_index "$weekday"
			orig_wdi=$wdi
			weekday_index "$wkst"
			wkst_wdi=$wdi
			# Weeks are counted from the WKST-aligned week start, not from
			# DTSTART's weekday, or INTERVAL>=2 with a multi-day BYDAY drifts.
			orig_wdi=$(((orig_wdi - wkst_wdi + 7) % 7))
		fi

		parse_leads "$trigger"
		max_lead=0
		for lead in "${leads[@]}"; do
			((lead > max_lead)) && max_lead=$lead
		done
		# Enough candidate days ahead for the earliest alarm to be reachable.
		max_off=$((max_lead / 86400 + 2))

		# ponytail: one date fork per EXDATE value; batch through `date -f -` if
		# a calendar ever carries hundreds of them.
		ex_epochs=()
		if [[ -n "$exdate" ]]; then
			IFS=$'\x1e' read -ra exlines <<<"$exdate"
			for exline in "${exlines[@]}"; do
				IFS=',' read -ra exvals <<<"${exline#*:}"
				for exv in "${exvals[@]}"; do
					field_to_epoch "${exline%%:*}:$exv" || continue
					ex_epochs["$sdt_epoch"]=1
				done
			done
		fi

		# Local midnight, then aim each candidate at local noon: adding 86400 to
		# a midnight lands on the wrong day across a DST change, which both skips
		# a date and throws the day/week counts off by one.
		today_mid=$(tz_date "$tz" -d 'today 00:00' +%s) || continue

		for ((offset_days = -1; offset_days <= max_off; offset_days++)); do
			cand_day_epoch=$((today_mid + offset_days * 86400 + 43200))
			((cand_day_epoch >= orig_day_epoch)) || continue
			read -r cand_date weekday <<<"$(tz_date "$tz" -d "@$cand_day_epoch" +'%Y%m%d %a')"

			# BYDAY restricts DAILY too ("every weekday" is FREQ=DAILY;BYDAY=MO..FR).
			weekday=${weekday^^}
			weekday=${weekday:0:2}
			[[ "$freq" != "YEARLY" && -n "$byday_days" && ",$byday_days," != *",$weekday,"* ]] && continue

			matches=0
			if [[ "$freq" == "DAILY" ]]; then
				days_diff=$(((cand_day_epoch - orig_day_epoch) / 86400))
				((days_diff % interval == 0)) && matches=1
			elif [[ "$freq" == "WEEKLY" ]]; then
				days_diff=$(((cand_day_epoch - orig_day_epoch) / 86400))
				weekday_index "$weekday"
				weeks_diff=$(((days_diff - (wdi - wkst_wdi + 7) % 7 + orig_wdi) / 7))
				((weeks_diff % interval == 0)) && matches=1
			elif [[ "$freq" == "YEARLY" ]]; then
				# Same month and day as DTSTART, INTERVAL counted in years. BYMONTH
				# and BYDAY refinements are not expanded; those are all-day holiday
				# feeds, which the all-day filter drops before this runs. A Feb 29
				# DTSTART matching only in leap years is the RFC behavior.
				if [[ "${cand_date:4:4}" == "${value:4:4}" ]] &&
					(((10#${cand_date:0:4} - 10#${value:0:4}) % interval == 0)); then
					matches=1
				fi
			else
				cand_ym=$((10#${cand_date:0:4} * 12 + 10#${cand_date:4:2}))
				(((cand_ym - orig_ym) % interval == 0)) || continue
				cand_dom=$((10#${cand_date:6:2}))
				days_in_month "$((10#${cand_date:0:4}))" "$((10#${cand_date:4:2}))"
				# When both are present RFC 5545 makes each a limit, so require both:
				# BYDAY=FR;BYMONTHDAY=13 is Friday the 13th, not every Friday.
				byday_ok=1 bmd_ok=1
				if [[ -n "$byday" ]]; then
					byday_ok=0
					# The weekday filter above already passed, so only the ordinal is
					# left: "2TU" is the 2nd Tuesday, "-1FR" the last Friday, bare "TU"
					# every Tuesday.
					for part in "${byday_parts[@]}"; do
						[[ "$weekday" == "${part: -2}" ]] || continue
						nth="${part%??}"
						[[ -z "$nth" ]] && byday_ok=1 && continue
						if [[ "$nth" == -* ]]; then
							(((dim - cand_dom) / 7 + 1 == 10#${nth#-})) && byday_ok=1
						else
							(((cand_dom - 1) / 7 + 1 == 10#${nth#+})) && byday_ok=1
						fi
					done
				fi
				if [[ -z "$byday" ]] || ((has_bymonthday)); then
					bmd_ok=0
					for md in "${bymonthdays[@]}"; do
						if [[ "$md" == -* ]]; then target=$((dim - 10#${md#-} + 1)); else target=$((10#$md)); fi
						((target == cand_dom)) && bmd_ok=1
					done
				fi
				((byday_ok && bmd_ok)) && matches=1
			fi
			((matches)) || continue

			cand_epoch=$(tz_date "$tz" -d "$cand_date ${orig_hms:0:2}:${orig_hms:2:2}:${orig_hms:4:2}" +%s) || continue
			[[ -n "$until_epoch" ]] && ((cand_epoch > until_epoch)) && continue
			[[ -n "${ex_epochs["$cand_epoch"]+x}" ]] && continue
			[[ -n "${overridden["$uid|$cand_epoch"]+x}" ]] && continue

			maybe_notify "$uid" "$cand_epoch" "$summary" "$location"
		done
	done
	return 0
}

for ics_url in "${calendar_urls[@]}"; do
	process_calendar "$ics_url"
done
