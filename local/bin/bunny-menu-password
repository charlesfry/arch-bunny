#!/bin/bash
# bunny-menu-password [entry]
#
# Change the login password or the disk encryption passphrase.
#
# Always runs in a terminal: both tools read their prompts from a tty, and
# neither should ever be driven from a menu that could mis-report what it did.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=local/bin/lib/helpers.sh
source "$SCRIPT_DIR/lib/helpers.sh"

# The LUKS container is found rather than assumed: -r keeps lsblk's tree
# glyphs out of the device path.
luks_device() {
  lsblk -rno NAME,FSTYPE | awk '$2 == "crypto_LUKS" { print "/dev/" $1 }' | head -n1
}

choice="${1:-}"
if [[ -z $choice ]]; then
  choice=$(printf '%s\n' \
    "Login password" \
    "Disk encryption passphrase" \
    | bunny-launch-menu "Change:") || exit 0
fi
[[ -n $choice ]] || exit 0

require_terminal "$0" "$choice"

case $choice in
  Login*)
    passwd
    ;;

  Disk*)
    device=$(luks_device)
    if [[ -z $device ]]; then
      echo "No LUKS device found on this system." >&2
      exit 1
    fi

    cat <<EOF

Changing the LUKS passphrase on $device

This replaces the passphrase in its key slot. You will be asked for the
current passphrase first, so keep it to hand. If the new passphrase is
lost, the disk cannot be recovered -- there is no reset for this.

EOF
    read -r -p "Type CHANGE to continue: " confirmation
    if [[ $confirmation != CHANGE ]]; then
      echo "Cancelled."
      exit 0
    fi

    sudo cryptsetup luksChangeKey "$device"
    echo "Passphrase changed. Keep the old one until you have rebooted once."
    ;;

  *) exit 0 ;;
esac

read -r -n1 -s -p "Done. Press any key to close."
echo
