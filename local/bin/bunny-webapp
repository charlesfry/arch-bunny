#!/bin/bash
# bunny-webapp [install [name] [url] | remove [name]]
#
# Turn a URL into something the launcher treats as an application: its own
# entry, its own window, its own app-id, no browser chrome.
#
# Costs nothing until launched -- a .desktop file is a text file, and the
# browser it opens is the one already installed.
set -euo pipefail

APPLICATIONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
PREFIX=bunny-webapp

# Desktop-entry ids and --class values have to be predictable to map back to
# the app, so the name is reduced to lowercase alphanumerics and dashes.
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'
}

action="${1:-}"
if [[ -z $action ]]; then
  action=$(printf '%s\n' install remove | bunny-launch-menu "Web app:") || exit 0
fi

case $action in
install)
  name="${2:-}"
  url="${3:-}"
  [[ -n $url ]]  || url=$(bunny-launch-menu "URL:" </dev/null) || exit 0
  [[ -n $url ]]  || exit 0
  [[ $url == *://* ]] || url="https://$url"
  [[ -n $name ]] || name=$(bunny-launch-menu "Name:" </dev/null) || exit 0
  [[ -n $name ]] || exit 0

  slug=$(slugify "$name")
  [[ -n $slug ]] || { bunny-notify -u critical "Web app" "Name has no usable characters"; exit 1; }
  class="$PREFIX-$slug"

  mkdir -p -- "$APPLICATIONS_DIR"
  # StartupWMClass matches --class so the window maps back to this entry
  # instead of showing up as another browser window.
  cat > "$APPLICATIONS_DIR/$class.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=brave --app=$url --class=$class
Icon=web-browser
StartupWMClass=$class
Categories=Network;
EOF

  update-desktop-database "$APPLICATIONS_DIR" 2>/dev/null || true
  bunny-notify "Web app installed" "$name"
  ;;

remove)
  name="${2:-}"
  if [[ -z $name ]]; then
    mapfile -t entries < <(find "$APPLICATIONS_DIR" -maxdepth 1 -name "$PREFIX-*.desktop" -printf '%f\n' 2>/dev/null | sed "s/^$PREFIX-//; s/\.desktop$//" | sort)
    ((${#entries[@]})) || { bunny-notify "Web app" "None installed"; exit 0; }
    name=$(printf '%s\n' "${entries[@]}" | bunny-launch-menu "Remove:") || exit 0
  fi
  [[ -n $name ]] || exit 0

  slug=$(slugify "$name")
  entry="$APPLICATIONS_DIR/$PREFIX-$slug.desktop"
  if [[ ! -f $entry ]]; then
    bunny-notify -u critical "Web app" "Not installed: $name"
    exit 1
  fi
  rm -f -- "$entry"
  update-desktop-database "$APPLICATIONS_DIR" 2>/dev/null || true
  bunny-notify "Web app removed" "$name"
  ;;

*) exit 0 ;;
esac
