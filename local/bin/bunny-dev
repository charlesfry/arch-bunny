#!/bin/bash
set -euo pipefail

DOCKER_PACKAGES=(docker docker-buildx docker-compose ufw-docker)
PI_PACKAGES=(nodejs npm glow)
PI_NPM_PACKAGE=@earendil-works/pi-coding-agent

usage() {
  cat <<'EOF'
Usage:
  bunny-dev status
  bunny-dev install pi
  bunny-dev remove pi
EOF
}

package_installed() {
  pacman -Q "$1" >/dev/null 2>&1
}

development_status() {
  local package state

  printf 'Core build environment:\n'
  for package in base-devel yay; do
    if package_installed "$package"; then
      state=installed
    else
      state=missing
    fi
    printf '  %-16s %s\n' "$package" "$state"
  done

  printf 'Docker environment:\n'
  for package in "${DOCKER_PACKAGES[@]}"; do
    if package_installed "$package"; then
      state=installed
    else
      state=missing
    fi
    printf '  %-16s %s\n' "$package" "$state"
  done

  if systemctl is-enabled --quiet docker.socket 2>/dev/null; then
    printf '  %-16s enabled\n' docker.socket
  else
    printf '  %-16s disabled\n' docker.socket
  fi

  if grep -Fq 'BEGIN UFW AND DOCKER' /etc/ufw/after.rules 2>/dev/null; then
    printf '  %-16s installed\n' 'UFW rules'
  else
    printf '  %-16s missing\n' 'UFW rules'
  fi

  printf 'Pi environment:\n'
  for package in "${PI_PACKAGES[@]}"; do
    if package_installed "$package"; then
      state=installed
    else
      state=missing
    fi
    printf '  %-16s %s\n' "$package" "$state"
  done
  if command -v pi >/dev/null 2>&1; then
    printf '  %-16s %s (%s)\n' pi installed "$(pi --version 2>/dev/null || printf 'version unknown')"
  else
    printf '  %-16s missing\n' pi
  fi
}

install_pi() {
  sudo pacman -S --needed "${PI_PACKAGES[@]}"
  npm install --global --ignore-scripts --prefix "$HOME/.local" "$PI_NPM_PACKAGE"

  printf '\nPi and Glow are installed. Run pi and use /login before using Hivemind.\n'
}

remove_pi() {
  local answer

  read -r -p 'Remove Pi and Glow? [y/N] ' answer
  [[ $answer =~ ^[Yy]([Ee][Ss])?$ ]] || {
    printf 'Pi removal cancelled.\n'
    return 0
  }

  if command -v npm >/dev/null 2>&1 &&
    npm list --global --prefix "$HOME/.local" --depth=0 "$PI_NPM_PACKAGE" >/dev/null 2>&1; then
    npm uninstall --global --prefix "$HOME/.local" "$PI_NPM_PACKAGE"
  fi

  # nodejs and npm are left alone: anything else installed through npm would go with them
  if package_installed glow; then
    sudo pacman -Rns --noconfirm glow
  fi

  printf '\nPi and Glow were removed. Node.js and npm were left in place, and ~/.pi was preserved.\n'
}

case ${1:-} in
  '')
    usage
    ;;
  status)
    (($# == 1)) || { usage >&2; exit 2; }
    development_status
    ;;
  install|remove)
    (($# == 2)) || { usage >&2; exit 2; }
    [[ $2 == pi ]] || {
      printf 'Unknown development environment: %s\n' "$2" >&2
      exit 2
    }
    "${1}_${2}"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
