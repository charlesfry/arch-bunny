#!/bin/bash

if [[ "$1" == power ]]; then
  batteries=(/sys/class/power_supply/BAT*)
  BAT=${batteries[0]}
  status=$(<"$BAT/status")
  [[ $status == Discharging ]] && status=""
  limit=""
  [[ -r $BAT/charge_control_end_threshold ]] && limit=$(<"$BAT/charge_control_end_threshold")
  [[ $limit == 100 ]] && limit=""
  bunny-notify "Battery Level" "$(<"$BAT/capacity")% ${status:+ $status}${limit:+ (limit ${limit}%)}" --expire-time 3000
  exit
fi

options="Sound
  Wifi
  Bluetooth
  Restart hardware"

case $(bunny-launch-menu "" <<< "$options") in
  *Restart*)          bunny-menu-hardware ;;
  *Sound*)            bunny-launch-term-float wiremix ;;
  *Wifi*)             bunny-launch-wifi ;;
  *Bluetooth*)        bunny-launch-bluetooth ;;
esac
