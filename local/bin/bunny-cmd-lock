#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/helpers.sh"

XDG_SESSION_ID="${XDG_SESSION_ID:-$(loginctl show-session auto --property=Id --value)}"
: "${XDG_SESSION_ID:?could not determine the graphical session}"

systemctl --user start swayidle.service
signal_waybar "10" # signal waybar that swayidle is running
loginctl lock-session "$XDG_SESSION_ID"
