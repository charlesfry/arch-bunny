; Deviations from git's own defaults only. `CHOICES.md`, `git-config`.
;
; Identity (user.name/user.email) is deliberately NOT here: this file is
; tracked, so anything in it ships to everyone who installs.
;
; It lives in ~/.gitconfig instead, which `install/20-dotfiles.sh` creates so
; that it always exists. That one file being present is what keeps identity out
; of this one: `git config --global` picks ~/.gitconfig whenever it exists and
; only falls back to ~/.config/git/config (this file, via a symlink) when it
; does not. Git reads both regardless, with ~/.gitconfig winning ties, so
; ordinary `git config --global user.email ...` lands untracked and overrides
; anything set here. Nothing needs to include anything.
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[commit]
	verbose = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[rerere]
	enabled = true
	autoUpdate = true
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
