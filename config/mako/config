# Global settings
max-history=10
max-visible=5
default-timeout=0
anchor=top-right
width=320

# Styling — neon blue/pink
font=SpaceMono Nerd Font Mono, Symbols Nerd Font Mono, monospace 10
background-color=#0d0e17ff
text-color=#e8ecffff
border-color=#4fd8ffff
border-size=2
border-radius=0
padding=15
max-icon-size=32
icon-location=right
outer-margin=0
margin=5

# Formatting
format=<b>%s</b>\n<i>%b</i>

# Bindings
on-button-right=dismiss
on-notify=exec mpv --no-config --no-video --really-quiet "$HOME/.config/mako/sound.mp3"

[app-name=Spotify]
invisible=1
on-notify=none

[urgency=critical]
default-timeout=0
text-color=#ff8de8ff
border-color=#ff4fd8ff
#layer=overlay
on-notify=exec mpv --no-config --no-video --really-quiet "$HOME/.config/mako/sound-critical.mp3"

# notify-send -c silent
[category=silent]
on-notify=none

# Last so it also silences criticals
[mode=dnd]
invisible=1
on-notify=none

# bunny-osd: volume and brightness levels, replaced in place rather than stacked
[app-name=bunny-osd]
anchor=bottom-center
layer=overlay
width=220
outer-margin=0,0,80
padding=8
default-timeout=1000
history=0
format=%s
text-alignment=center
progress-color=over #4fd8ff66
on-notify=none

# A level is feedback for a key just pressed, so DND doesn't hide it
[mode=dnd app-name=bunny-osd]
invisible=0

