# Global settings
max-history=10
max-visible=5
default-timeout=5000
anchor=top-right
width=300

# Styling
font=Noto Sans Mono, Symbols Nerd Font Mono, monospace 10
background-color=#2c3540ff
text-color=#c9cfdaff
border-color=#4d5765ff
border-size=1
border-radius=0
padding=15
max-icon-size=32
outer-margin=0
margin=5

# Formatting
format=<b>%s</b>\n<i>%b</i>

# Bindings
on-button-right=dismiss

[app-name=Spotify]
invisible=1

[mode=dnd]
invisible=1

[urgency=critical]
default-timeout=0
text-color=#d77c73
#layer=overlay
