# Global settings
max-history=10
max-visible=5
default-timeout=2000
anchor=top-right
width=300

# Styling
font=Noto Sans Mono, Symbols Nerd Font Mono, monospace 10
background-color=#3b4045ff
text-color=#f5f5f0ff
border-color=#d4af37ff
border-size=2
border-radius=0
padding=15
max-icon-size=32
icon-location=right
outer-margin=0
margin=5

# Formatting
format=<b>%s</b>\n<i>%b</i>

# Bindings
on-button-right=dismiss

[app-name=Spotify]
invisible=1

[mode=dnd]
invisible=1

[urgency=critical]
default-timeout=0
text-color=#d77c73
#layer=overlay
