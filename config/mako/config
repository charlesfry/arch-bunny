# Global settings
max-history=10
max-visible=5
default-timeout=0
anchor=top-right
width=320

# Styling — palette lifted from the Nidoran icons
font=SpaceMono Nerd Font Mono, Symbols Nerd Font Mono, monospace 10
background-color=#161320ff
text-color=#f5f2ffff
border-color=#9b9bf5ff
border-size=2
border-radius=0
padding=15
max-icon-size=32
icon-location=right
outer-margin=0
margin=5

# Formatting
format=<b>%s</b>\n<i>%b</i>

# Bindings
on-button-right=dismiss
on-notify=exec mpv --no-config --no-video --really-quiet "$HOME/.config/mako/sound.mp3"

[app-name=Spotify]
invisible=1
on-notify=none

[urgency=critical]
default-timeout=0
text-color=#e69cd5ff
border-color=#bd62c5ff
#layer=overlay
on-notify=exec mpv --no-config --no-video --really-quiet "$HOME/.config/mako/sound-critical.mp3"

# Last so it also silences criticals
[mode=dnd]
invisible=1
on-notify=none

