{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"width": 28,
    	"height": 20,
    	"padding": {
    		"top": 3,
    		"left": 7
    	}
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╭──────────────────────┐\u001b[1m\u001b[38;2;197;200;198mHardware\u001b[22m\u001b[38;2;62;68;81m┌──────────────────────╮"
        },
        {
            "type": "host",
            "key": "{icon} PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "└ └󰋊",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╰──────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╭──────────────────────┐\u001b[1m\u001b[38;2;197;200;198mSoftware\u001b[22m\u001b[38;2;62;68;81m┌──────────────────────╮"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "bios",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "command",
            "key": " DE",
            "text": "echo $XDG_SESSION_TYPE",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├󰍂",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╰──────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╭───────────────────┐\u001b[1m\u001b[38;2;197;200;198mUptime / Age / DT\u001b[22m\u001b[38;2;62;68;81m┌────────────────╮"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;62;68;81m╰──────────────────────────────────────────────────────╯"
        }
    ]
}
