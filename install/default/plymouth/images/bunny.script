# Dot Plymouth theme - quiet terminal-style boot screen

Window.SetBackgroundTopColor(0.035, 0.047, 0.051);
Window.SetBackgroundBottomColor(0.035, 0.047, 0.051);

foreground = 0.78;
bright = 0.91;
cursor_on = 1;
cursor_ticks = 0;
progress_phase = 0;
status = "normal";

title.image = Image("bunny-title.png");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - title.image.GetWidth() / 2,
                         Window.GetY() + Window.GetHeight() * 0.34,
                         10);

status_y = Window.GetY() + Window.GetHeight() * 0.43;
message_gap = 8;
message_x = Window.GetX() + Window.GetWidth() * 0.375;
message_lines[0] = "";
message_lines[1] = "";
message_lines[2] = "";
message_lines[3] = "";
message_sprites[0] = Sprite();
message_sprites[1] = Sprite();
message_sprites[2] = Sprite();
message_sprites[3] = Sprite();
message_images[0] = Image.Text("", foreground, foreground, foreground);
message_images[1] = Image.Text("", foreground, foreground, foreground);
message_images[2] = Image.Text("", foreground, foreground, foreground);
message_images[3] = Image.Text("", foreground, foreground, foreground);
for (index = 0; index < 4; index++)
  {
    message_sprites[index].SetPosition(message_x,
                                       status_y + index * 28,
                                       10 + index);
  }

fun draw_messages ()
  {
    for (index = 0; index < 4; index++)
      {
        if (message_lines[index] != "")
          {
            message_images[index] = Image.Text(message_lines[index], foreground, foreground, foreground);
            message_sprites[index].SetImage(message_images[index]);
            message_sprites[index].SetX(message_x);
            message_sprites[index].SetY(status_y + index * 28);
            message_sprites[index].SetOpacity(1);
          }
        else
          {
            message_sprites[index].SetOpacity(0);
          }
      }
  }

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2,
                          Window.GetY() + Window.GetHeight() * 0.63, 20);

cursor_image = Image("cursor.png");
cursor_sprite = Sprite(cursor_image);
cursor_sprite.SetOpacity(0);
password_sprite = Sprite();
password_sprite.SetOpacity(0);

fun update_prompt (text, bullets)
  {
    prompt_image = Image.Text("passphrase:", foreground, foreground, foreground);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);

    password = "";
    for (index = 0; index < bullets; index++)
      {
        password += "*";
      }
    password_image = Image.Text(password, bright, bright, bright);
    password_sprite.SetImage(password_image);
    password_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 + prompt_image.GetWidth() / 2 + 8,
                                Window.GetY() + Window.GetHeight() * 0.63,
                                21);
    password_sprite.SetOpacity(1);
    cursor_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 + prompt_image.GetWidth() / 2 + 8 + password_image.GetWidth() + 8);
    cursor_sprite.SetY(Window.GetY() + Window.GetHeight() * 0.63);
    prompt_sprite.SetOpacity(1);
    cursor_sprite.SetOpacity(1);
  }

fun refresh_callback ()
  {
    if (status == "password")
      {
        cursor_ticks += 1;
        if (cursor_ticks >= 12)
          {
            cursor_ticks = 0;
            cursor_on = 1 - cursor_on;
            cursor_sprite.SetOpacity(cursor_on);
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

fun display_normal_callback ()
  {
    status = "normal";
    cursor_ticks = 0;
    prompt_sprite.SetOpacity(0);
    password_sprite.SetOpacity(0);
    cursor_sprite.SetOpacity(0);
  }

fun display_password_callback (prompt, bullets)
  {
    status = "password";
    update_prompt(prompt, bullets);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_message_callback (text)
  {
    for (index = 3; index > 0; index--)
      {
        message_lines[index] = message_lines[index - 1];
      }
    message_lines[0] = "> " + text;
    draw_messages();
  }

Plymouth.SetUpdateStatusFunction(display_message_callback);

fun hide_message_callback (text)
  {
    # Preserve the four-line history until newer messages scroll it away.
  }

Plymouth.SetHideMessageFunction(hide_message_callback);

fun quit_callback ()
  {
    title.sprite.SetOpacity(1);
  }

Plymouth.SetQuitFunction(quit_callback);
