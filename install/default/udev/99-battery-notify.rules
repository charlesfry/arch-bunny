# Event-driven battery low/critical notifications. Piggybacks on the kernel
# power_supply uevent that already fires on capacity/status change instead of
# running a resident watcher (upower --monitor, a polling timer, etc).
#
# @BIN@ is substituted with the installing user's ~/.local/bin by
# install/30-system-services.sh. udev does not expand $HOME or ~, so the path
# has to be baked in at install time rather than written literally here.
ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Battery", RUN+="@BIN@/bunny-battery-notify"
