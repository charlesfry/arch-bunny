# Hand the EC charge ceiling to wheel so bunny-toggle-charge-limit does not need
# sudo. The attribute only appears once cros_charge-control probes, which can
# land after the add event, so this rides the change events the battery already
# emits on capacity/status rather than firing once at boot.
ACTION=="add|change", SUBSYSTEM=="power_supply", ATTR{type}=="Battery", RUN+="/usr/bin/chgrp wheel /sys%p/charge_control_end_threshold", RUN+="/usr/bin/chmod g+w /sys%p/charge_control_end_threshold"
